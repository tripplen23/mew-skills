{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tripplen23/mew-skills/schemas/capability-report.schema.json",
  "title": "Capability Preflight Report",
  "description": "Read-only host capability report produced by check_capabilities.py",
  "type": "object",
  "required": ["schema_version", "timestamp", "status", "checks"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "purpose", "status", "command", "args", "resolved_path",
          "version_output", "required", "stack", "min_version", "detected_version"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["available", "missing", "incompatible", "not_applicable"]
          },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "resolved_path": { "type": ["string", "null"] },
          "version_output": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "stack": { "type": ["string", "null"] },
          "min_version": {
            "type": ["string", "null"],
            "pattern": "^\\d+(?:\\.\\d+)*$"
          },
          "detected_version": {
            "type": ["string", "null"],
            "pattern": "^\\d+(?:\\.\\d+)*$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": {
        "properties": {
          "checks": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["required", "status"],
                "properties": {
                  "required": { "const": true },
                  "status": { "enum": ["missing", "incompatible"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } } },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "required": ["required", "status"],
              "properties": {
                "required": { "const": true },
                "status": { "enum": ["missing", "incompatible"] }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
